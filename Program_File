def patrol_summary():

    total_fines = len(fine_registry)

   
    total_fine_amount = 0
   

    highest_offender = None
   
    highest_speed = 0

    for last_name, offender in fine_registry.items():

        # Add the fine to the total
        total_fine_amount += offender["fine"]

        # Calculate how far over the limit they were
        if "amount over the speed limit (km/h)" in offender:

            over_speed = offender["amount over the speed limit (km/h)"]

        else:

            over_speed = offender["speed"] - offender["max speed limit"]

        # Check if this is the highest offender
        if over_speed > highest_speed:

            highest_speed = over_speed

            highest_offender = (
                offender["first_name"] + " " + last_name
            )

    clear_console()



    print(f"Total fines issued: {total_fines}")
   
    print(f"Total amount in fines: ${total_fine_amount}")
   
    if highest_offender is not None:

        print(f"Highest speeding offender: {highest_offender}")

       
        print(f"Amount over speed limit: {highest_speed} km/h")

    else:

        print("Highest speeding offender: None")




    input("\nPress Enter to return to the home page:")

    home_page()


